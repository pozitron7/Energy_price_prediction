# Copy to .env (or export in your shell). All values are optional.

# Free token from https://transparency.entsoe.eu/ - enables REAL wind/solar generation.
ENTSOE_API_TOKEN=

# Leave unset to use local SQLite (data/energy.db). For Docker TimescaleDB:
# DATABASE_URL=postgresql+psycopg2://energy_user:energy_pass@localhost:5432/energy_db
